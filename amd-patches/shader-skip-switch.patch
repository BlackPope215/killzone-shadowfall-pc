From c36b0e95d94dda36eef8bc2b9afadb3ebed1d03b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20Pape=C5=BE?= <martin.papez@gmail.com>
Date: Mon, 9 Nov 2026 02:04:25 +0100
Subject: [PATCH] vulkan: GOW3_SKIP_FILE switch to drop draws/dispatches by
 shader hash

For bisecting which pass makes an artifact while the game runs: draws whose vertex or pixel
shader hash, and dispatches whose compute shader hash, is listed in the file are not recorded.
The file (hex hashes as in the frame analyzer's vs/ps/cs columns, '#' comments) is read again
whenever it changes. No cost unless GOW3_SKIP_FILE is set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JF414jy1cdTDi9JXbSh73A
---
 .../renderer_vulkan/vk_rasterizer.cpp         |   9 +-
 .../renderer_vulkan/vk_shader_skip.h          | 113 ++++++++++++++++++
 2 files changed, 120 insertions(+), 2 deletions(-)
 create mode 100644 gpu/shadps4/video_core/renderer_vulkan/vk_shader_skip.h

diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_rasterizer.cpp b/gpu/shadps4/video_core/renderer_vulkan/vk_rasterizer.cpp
index 151200b..0018a77 100644
--- a/gpu/shadps4/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -27,6 +27,7 @@
 #include "video_core/renderer_vulkan/vk_res_census.h"
 #include "video_core/renderer_vulkan/vk_pipeline_cache.h"
 #include "video_core/renderer_vulkan/vk_rasterizer.h"
+#include "video_core/renderer_vulkan/vk_shader_skip.h"
 #include "video_core/renderer_vulkan/vk_gpu_profiler.h"
 #include "gow3_threads.h"
 #include "video_core/renderer_vulkan/vk_runtime.h"
@@ -1382,7 +1383,10 @@ void Rasterizer::DrawRecord(const GraphicsPipeline* pipeline, const PreparedDraw
     const u32 num_instances = regs.num_instances.NumInstances();
     const u32 first_vertex = vertex_offset;
     const u32 first_instance = instance_offset;
-    scheduler.Record([=](vk::CommandBuffer cmdbuf) {
+    // gow3: GOW3_SKIP_FILE (vk_shader_skip.h) drops listed shaders to bisect an artifact.
+    const auto* skip_ps = pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+    const bool skip_draw = ShaderSkip::Skip(vs_info.pgm_hash, skip_ps ? skip_ps->pgm_hash : 0);
+    if (!skip_draw) scheduler.Record([=](vk::CommandBuffer cmdbuf) {
         const auto draw = [&] {
             if (is_indexed) {
                 cmdbuf.drawIndexed(num_indices, num_instances, 0, s32(first_vertex),
@@ -1611,7 +1615,8 @@ void Rasterizer::DispatchRecord(const ComputePipeline* pipeline) {
     if (FrameCapture::Active()) {
         FrameCapture::Dispatch(cs.pgm_hash, dim_x, dim_y, dim_z);
     }
-    scheduler.Record([=](vk::CommandBuffer cmdbuf) {
+    // gow3: GOW3_SKIP_FILE (vk_shader_skip.h).
+    if (!ShaderSkip::Skip(cs.pgm_hash)) scheduler.Record([=](vk::CommandBuffer cmdbuf) {
         if (Scheduler::FullBarriers()) {
             Scheduler::RecordFullBarrier(cmdbuf);
         }
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_shader_skip.h b/gpu/shadps4/video_core/renderer_vulkan/vk_shader_skip.h
new file mode 100644
index 0000000..378875d
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_shader_skip.h
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// gow3: GOW3_SKIP_FILE=<path>: draws and dispatches whose vertex, pixel or compute shader hash
+// (the 8 hex digits of the frame analyzer's "vs/ps" and "cs" columns) is listed in the file are
+// not recorded. The file is read again whenever it changes, so a tester can bisect which pass
+// makes an artifact while the game runs: hex hashes separated by spaces, commas or new lines,
+// '#' starts a comment. Off (no cost) unless the variable is set.
+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+
+namespace Vulkan::ShaderSkip {
+
+namespace Detail {
+struct State {
+    std::mutex mutex;
+    std::unordered_set<std::uint32_t> hashes;
+    std::filesystem::file_time_type stamp{};
+    std::chrono::steady_clock::time_point next_check{};
+    bool exists{};
+};
+
+inline const char* Path() {
+    static const char* path = [] {
+        const char* p = std::getenv("GOW3_SKIP_FILE");
+        if (p && *p) {
+            std::printf("GPU: shader skip list from %s (GOW3_SKIP_FILE)\n", p);
+            return p;
+        }
+        return static_cast<const char*>(nullptr);
+    }();
+    return path;
+}
+
+inline State& Get() {
+    static State state;
+    return state;
+}
+
+inline void Reload(State& s, const char* path) {
+    s.hashes.clear();
+    std::ifstream in(path);
+    std::string line;
+    while (std::getline(in, line)) {
+        if (const auto hash = line.find('#'); hash != std::string::npos) {
+            line.resize(hash);
+        }
+        for (char& c : line) {
+            if (c == ',' || c == ';' || c == '\t' || c == '\r') {
+                c = ' ';
+            }
+        }
+        std::size_t pos = 0;
+        while (pos < line.size()) {
+            const auto start = line.find_first_not_of(' ', pos);
+            if (start == std::string::npos) {
+                break;
+            }
+            const auto end = line.find(' ', start);
+            const std::string token = line.substr(start, end - start);
+            pos = end == std::string::npos ? line.size() : end;
+            char* tail = nullptr;
+            const unsigned long long value = std::strtoull(token.c_str(), &tail, 16);
+            if (tail && *tail == '\0' && !token.empty()) {
+                s.hashes.insert(static_cast<std::uint32_t>(value));
+            }
+        }
+    }
+    std::printf("GPU: shader skip list: %zu hashes\n", s.hashes.size());
+}
+} // namespace Detail
+
+/// True when a draw or dispatch with these shader hashes must not be recorded.
+inline bool Skip(std::uint64_t first, std::uint64_t second = 0) {
+    const char* path = Detail::Path();
+    if (!path) {
+        return false;
+    }
+    auto& s = Detail::Get();
+    std::scoped_lock lock{s.mutex};
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= s.next_check) {
+        s.next_check = now + std::chrono::milliseconds(500);
+        std::error_code ec;
+        const auto stamp = std::filesystem::last_write_time(path, ec);
+        if (ec) {
+            if (s.exists) {
+                s.exists = false;
+                s.hashes.clear();
+                std::printf("GPU: shader skip list: file gone, nothing skipped\n");
+            }
+        } else if (!s.exists || stamp != s.stamp) {
+            s.exists = true;
+            s.stamp = stamp;
+            Detail::Reload(s, path);
+        }
+    }
+    if (s.hashes.empty()) {
+        return false;
+    }
+    return (first && s.hashes.contains(static_cast<std::uint32_t>(first))) ||
+           (second && s.hashes.contains(static_cast<std::uint32_t>(second)));
+}
+
+} // namespace Vulkan::ShaderSkip
